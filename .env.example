# ==========================================================================
# Sharon Tea Stall — server environment.
# Copy to .env and fill in. NEVER commit .env, and never put these values in
# anything under assets/ — that folder is downloaded by every visitor.
# ==========================================================================

# ── Razorpay ──────────────────────────────────────────────────────────────
# Dashboard → Settings → API Keys. Test keys start rzp_test_, live rzp_live_.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_key_secret_here

# Dashboard → Settings → Webhooks. This is a value YOU choose when creating the
# webhook — it is NOT the key secret above.
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ── Site ──────────────────────────────────────────────────────────────────
# Lock the API to your own domain in production.
ALLOWED_ORIGIN=https://www.teastall-demo.com

# Set to false to switch cash on delivery off site-wide.
ENABLE_COD=true

# ── Order notification email (optional) ───────────────────────────────────
# Leave blank to skip emails. For Gmail use an App Password, not the account
# password (Google Account → Security → 2-Step Verification → App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hello@teastall-demo.com
SMTP_PASS=your_16_character_app_password
SHOP_EMAIL=hello@teastall-demo.com

# ── Storage (optional) ────────────────────────────────────────────────────
# Where the order log is written. On Vercel this must live under /tmp and is
# NOT durable — see README, "Where orders are stored".
# ORDERS_FILE=/tmp/orders.jsonl
